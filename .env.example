APP_NAME="Auditor-IA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=auditor_ia
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# ---------------------------------------------------------------
# Redis
# ---------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------
# Mail
# ---------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@auditor-ia.cl"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Storage — S3 Compatible (Production)
# ---------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------
# Documents
# ---------------------------------------------------------------
DOCUMENT_STORAGE_DISK=local
DOCUMENT_MAX_SIZE_KB=51200
DOCUMENT_PROCESSING_QUEUE=documents

# ---------------------------------------------------------------
# LLM Providers
# ---------------------------------------------------------------
LLM_PROVIDER=groq

# Groq (Testing/Development)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Deepseek (Production alternative)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Azure OpenAI (Production)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ---------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=

# ---------------------------------------------------------------
# Stripe — Billing
# ---------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# Unstructured
# ---------------------------------------------------------------
# Local Docker: http://localhost:8000/general/v0/general
# Cloud partition API: https://api.unstructuredapp.io/general/v0/general
# (Copy your exact URL from https://platform.unstructured.io → API Keys)
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_TIMEOUT=120